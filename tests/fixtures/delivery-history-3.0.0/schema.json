      "type": "string"
    },
    "date": {
      "format": "date",
      "title": "Date",
      "type": "string"
    },
    "package": {
      "const": "delivery-history",
      "default": "delivery-history",
      "title": "Package",
      "type": "string"
    },
    "periods": {
      "description": "Every period with events, oldest first.",
      "items": {
        "$ref": "#/$defs/Period"
      },
      "title": "Periods",
      "type": "array"
    },
    "repositories": {
      "description": "The delivery repositories it covers.",
      "items": {
        "type": "string"
      },
      "title": "Repositories",
      "type": "array"
    },
    "schema_version": {
      "title": "Schema Version",
      "type": "string"
    },
    "sprint_metrics": {
      "anyOf": [
        {
          "$ref": "#/$defs/SprintMetrics"
        },
        {
          "type": "null"
